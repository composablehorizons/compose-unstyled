---
import Favicon from '../components/Favicon.astro';
import Analytics from '../components/Analytics.astro';
import '../styles/tokens.css';
import '../styles/landing.css';
import { sitePath, siteUrl } from '../../site.config.js';
import { sharedSkikoUrl } from '../../scripts/skiko-runtime.js';
const pageTitle = 'Compose Unstyled — The missing design system layer for Jetpack Compose';
const description = 'Accessible, renderless components and a flexible theming system for Jetpack Compose and Compose Multiplatform. Build your own design system for every platform.';
const canonicalUrl = siteUrl('/');
const socialImageUrl = siteUrl('/og_unstyled.png');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121212" media="(prefers-color-scheme: dark)" />
    <Favicon />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="675" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <link rel="sitemap" href={sitePath('/sitemap.xml')} />
    <link rel="preconnect" href="https://cdn.composables.com" crossorigin />
    <link rel="preload" href={sharedSkikoUrl} as="fetch" type="application/wasm" crossorigin />
    <Analytics />
  </head>
  <body>
    <a class="landing-skip-link" href="#main">Skip to content</a>
    <header class="landing-header">
      <a class="landing-brand titleLarge" href={sitePath('/')}>
        <img src={sitePath('/icons/compose-unstyled.svg')} width="32" height="32" alt="" />
        Compose Unstyled
      </a>
    </header>
    <main id="main"><slot /></main>
    <footer class="landing-footer">
      <a class="landing-brand titleMedium" href="https://composables.com" target="_blank" rel="noopener noreferrer nofollow">
        Made by
        <span class="landing-composables-name">
          <img class="landing-composables-logo" src={sitePath('/icons/composables-logo.svg')} width="22" height="22" alt="" />
          Composables
        </span>
      </a>
      <nav aria-label="Footer navigation">
        <a class="landing-link" href={sitePath('/docs/')}>Documentation</a>
        <a class="landing-link" href="https://github.com/composablehorizons/compose-unstyled" target="_blank" rel="noopener noreferrer nofollow">GitHub</a>
        <a class="landing-link" href={sitePath('/llms.txt')}>llms.txt</a>
      </nav>
    </footer>
  </body>
</html>
