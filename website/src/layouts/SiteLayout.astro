---
import Favicon from '../components/Favicon.astro';
import Analytics from '../components/Analytics.astro';
import '../styles/tokens.css';
import '../styles/docs.css';
import { site } from '../../site.config.js';
import { sharedSkikoUrl } from '../../scripts/skiko-runtime.js';
interface Props {
  title: string;
  description?: string;
  markdownUrl?: string;
}
const { title, description, markdownUrl } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121212" media="(prefers-color-scheme: dark)" />
    <Favicon />
    <title>{title} | Compose Unstyled</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={new URL(Astro.url.pathname, site)} />
    {markdownUrl && <link rel="alternate" type="text/markdown" href={markdownUrl} />}
    <link rel="preconnect" href="https://cdn.composables.com" crossorigin />
    <link rel="preload" href={sharedSkikoUrl} as="fetch" type="application/wasm" crossorigin />
    <Analytics />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <main id="main"><slot /></main>
  </body>
</html>
