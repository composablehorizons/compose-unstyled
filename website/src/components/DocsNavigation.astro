---
import docsYaml from '../../../docs/docs.yml?raw';
import { parse } from 'yaml';
import { sitePath } from '../../site.config.js';
const navigation = parse(docsYaml);
---
<nav id={Astro.props.id} class="docs-navigation" aria-label="Documentation">
  {navigation.sections.map(section => (
    <section>
      <h2>{section.title === 'Primitives' ? 'Components' : section.title}</h2>
      <ul>
        {section.pages.map(page => (
          <li><a href={sitePath(`/docs/${page.slug}/`)} aria-current={Astro.url.pathname.replace(/\/$/, '') === sitePath(`/docs/${page.slug}`) ? 'page' : undefined}>{page.title}</a></li>
        ))}
        {section.title === 'Resources' && (
          <>
            <li><a href={sitePath('/llms.txt')}>llms.txt</a></li>
            <li><a href={sitePath('/llms-full.txt')}>Full documentation for LLMs</a></li>
          </>
        )}
      </ul>
    </section>
  ))}
</nav>
