---
import { sitePath } from '../../site.config.mjs';
---
<link rel="icon" type="image/svg+xml" href={sitePath('/favicon-light.svg')} data-theme-favicon data-light={sitePath('/favicon-light.svg')} data-dark={sitePath('/favicon-dark.svg')} />
<script is:inline>
  (() => {
    const icon = document.querySelector('link[data-theme-favicon]');
    const theme = window.matchMedia('(prefers-color-scheme: dark)');
    const updateIcon = () => {
      icon.href = theme.matches ? icon.dataset.dark : icon.dataset.light;
    };
    updateIcon();
    theme.addEventListener('change', updateIcon);
  })();
</script>
