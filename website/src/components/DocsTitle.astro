---
import { sitePath } from '../../site.config.mjs';
const { entry } = Astro.locals.starlightRoute;
const markdownUrl = `${Astro.url.pathname.replace(/\/$/, '')}.md`;
---
<nav class="docs-breadcrumb" aria-label="Breadcrumb">
  <a href={sitePath('/')}>Compose Unstyled</a><span aria-hidden="true">›</span><span>{entry.data.title}</span>
</nav>
<div class="docs-title-row">
  <h1 id="_top">{entry.data.title}</h1>
  <a class="docs-markdown-link" href={markdownUrl}>View Markdown ↗</a>
</div>
{entry.data.description && <p class="docs-description">{entry.data.description}</p>}
